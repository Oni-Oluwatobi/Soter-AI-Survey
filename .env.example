# Copy to .env for local development. NEVER commit .env.
# This file contains placeholders only.

# Server-side admin password (required). Set the real value in Vercel → Settings → Environment Variables.
SOTER_ADMIN_PASSWORD=replace-with-your-admin-password

# Firebase service-account JSON for the soter-ai project (required).
# Accepts the raw JSON (with \n escapes in the private_key) or base64-encoded JSON.
# Create via: Firebase Console → Project settings → Service accounts → Generate new private key.
# NEVER expose this to the browser. NEVER commit the real file.
FIREBASE_SERVICE_ACCOUNT=

# Realtime Database URL for the existing soter-ai project (confirm in Firebase Console → Realtime Database).
FIREBASE_DATABASE_URL=https://soter-ai-default-rtdb.firebaseio.com

# Optional: extra secret for signing admin session cookies.
# If unset, a key derived from SOTER_ADMIN_PASSWORD is used (server-side only).
SOTER_SESSION_SECRET=
